---
import { type Bucket, formatEdge, rangeLabel, yTicks } from "../lib/histogram";

interface Props {
  buckets: Bucket[];
  /** 活跃门槛，只用于图注文案 */
  activeThreshold: number;
  /** 未发言人数：不在对数轴上，图下方单独说明 */
  silentCount: number;
}

const { buckets, activeThreshold, silentCount } = Astro.props;
const ticks = yTicks(Math.max(0, ...buckets.map((b) => b.total)));
const yMax = ticks[ticks.length - 1] || 1;
const pct = (n: number) => `${((n / yMax) * 100).toFixed(2)}%`;
---

{
  buckets.length > 0 && (
    <figure class="hist">
      <figcaption>
        <span class="cap-title">发言数分布</span>
        <span class="legend">
          <span><i class="sw active" />活跃（≥ {activeThreshold} 条）</span>
          <span><i class="sw" />其他</span>
        </span>
      </figcaption>

      <div class="plot">
        <div class="y-axis" aria-hidden="true">
          {ticks.map((t) => <span style={`bottom: ${pct(t)}`}>{t}</span>)}
        </div>
        <div class="area">
          <div class="grid" aria-hidden="true">
            {ticks.slice(1).map((t) => <i style={`bottom: ${pct(t)}`} />)}
          </div>
          <ol class="bars">
            {buckets.map((b) => {
              const label = rangeLabel(b);
              const tip = `${label}：${b.total} 人${b.active ? `，其中活跃 ${b.active} 人` : ""}`;
              return (
                <li class="bar" title={tip}>
                  <span class="val" aria-hidden="true">{b.total || ""}</span>
                  <div class="stack" style={`height: ${pct(b.total)}`}>
                    <i class="seg other" style={`flex: ${b.total - b.active}`} />
                    <i class="seg active" style={`flex: ${b.active}`} />
                  </div>
                  <span class="sr-only">{tip}</span>
                </li>
              );
            })}
          </ol>
          <div class="x-axis" aria-hidden="true">
            {buckets.map((b) => <span>{b.open ? `${formatEdge(b.lo)}+` : formatEdge(b.lo)}</span>)}
          </div>
        </div>
      </div>

      <p class="note">
        横轴为发言条数（从多到少，对数刻度；标签是每根柱的下限，如“10”指 10~19 条），纵轴为人数。另有 {silentCount} 人未发言，不在图中。
      </p>
    </figure>
  )
}

<style>
  .hist {
    margin: 0;
    padding: 1rem 1rem 0.75rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.4rem 1rem;
    margin-bottom: 0.9rem;
    font-size: 0.9rem;
  }
  .cap-title {
    font-weight: 600;
  }
  .legend {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .sw {
    display: inline-block;
    width: 10px;
    height: 10px;
    margin-right: 0.3rem;
    border-radius: 2px;
    background: var(--bar);
    vertical-align: -1px;
  }
  .sw.active {
    background: var(--accent);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .plot {
    --h: 180px;
    --bar: color-mix(in srgb, var(--muted) 45%, var(--surface));
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0 0.5rem;
    font-size: 0.7rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .y-axis {
    position: relative;
    height: var(--h);
    width: 2ch;
  }
  .y-axis span {
    position: absolute;
    right: 0;
    transform: translateY(50%);
    line-height: 1;
  }
  .area {
    position: relative;
  }
  .grid {
    position: absolute;
    inset: 0 0 auto 0;
    height: var(--h);
    border-bottom: 1px solid var(--border-strong);
  }
  .grid i {
    position: absolute;
    left: 0;
    right: 0;
    border-top: 1px dashed var(--border);
  }

  .bars {
    position: relative;
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: var(--h);
    margin: 0;
    padding: 0 2px;
    list-style: none;
  }
  .bar {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .val {
    text-align: center;
    line-height: 1;
    padding-bottom: 3px;
    color: var(--text);
    font-size: 0.7rem;
  }
  .stack {
    display: flex;
    flex-direction: column;
    min-height: 0;
    border-radius: 3px 3px 0 0;
    overflow: hidden;
  }
  .seg {
    display: block;
    flex-basis: 0;
    min-height: 0;
  }
  .seg.other {
    background: var(--bar);
  }
  .seg.active {
    background: var(--accent);
  }
  .bar:hover .seg.other {
    filter: brightness(0.92);
  }

  .x-axis {
    display: flex;
    padding: 0.35rem 2px 0;
    gap: 3px;
  }
  .x-axis span {
    flex: 1 1 0;
    min-width: 0;
    text-align: center;
    white-space: nowrap;
  }
  .note {
    margin: 0.75rem 0 0;
    font-size: 0.75rem;
    color: var(--muted);
  }

  @media (max-width: 480px) {
    .plot {
      --h: 140px;
      font-size: 0.6rem;
    }
    .val {
      font-size: 0.6rem;
    }
    /* 窄屏且柱多（≥ 12 根）：隐去柱顶数值，x 轴标签隔一显一（title 与 sr-only 文本仍在） */
    .bars:has(.bar:nth-child(12)) .val {
      display: none;
    }
    .x-axis:has(span:nth-child(12)) span:nth-child(even) {
      visibility: hidden;
    }
  }
</style>
