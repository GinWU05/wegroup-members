---
import {
  displayNameOf,
  hueOf,
  initialOf,
  type MemberRecord,
  searchTextOf,
  seedOf,
} from "../lib/members";

interface Props {
  member: MemberRecord;
  /** 排序序号（1 起）；发言为 0 的成员不展示名次，只用于浏览器端排序 */
  rank: number;
  /** 发言数 ≥ 活跃门槛（发过言成员的前 25%），由页面统一算好传入 */
  active: boolean;
  showRemark: boolean;
}

const { member: m, rank, active, showRemark } = Astro.props;
const spoke = m.msgCount > 0;
// 前三名（且发过言）：金银铜边框，第一名头像戴皇冠；零发言不参评（与名次规则一致）
const medal = spoke && rank <= 3 ? rank : 0;
const name = displayNameOf(m);
const hue = hueOf(seedOf(m));
// 副标题：群昵称与微信昵称不同时补充微信昵称，避免重复显示
const subtitle = m.displayName && m.nickName && m.displayName !== m.nickName ? m.nickName : "";
const remark = showRemark ? (m.remark ?? "") : "";
---

<li
  class:list={["card", { active }, medal > 0 && `top-${medal}`]}
  data-search={searchTextOf(m)}
  data-count={m.msgCount}
  data-name={name.toLowerCase()}
  data-rank={rank}
  data-active={active ? "" : undefined}
>
  <div class="avatar-box">
    <div class="avatar" style={`--hue: ${hue}`}>
      {
        m.avatar ? (
          <img src={`/${m.avatar}`} alt="" width="64" height="64" loading="lazy" decoding="async" />
        ) : (
          <span class="initial" aria-hidden="true">{initialOf(name)}</span>
        )
      }
    </div>
    {medal === 1 && <span class="crown" aria-hidden="true">👑</span>}
  </div>
  <div class="body">
    <div class="title-row">
      {spoke && <span class="rank">#{rank}</span>}
      <h3 class="name" title={name}>{name}</h3>
    </div>
    {subtitle && <p class="sub" title={subtitle}>{subtitle}</p>}
    {m.alias && <p class="alias">微信号 {m.alias}</p>}
    {remark && <p class="remark">备注 {remark}</p>}
  </div>
  <div
    class:list={["count", { zero: !spoke }]}
    title={active ? `${m.msgCount} 条发言，活跃成员` : `${m.msgCount} 条发言`}
  >
    <span class="num">{m.msgCount.toLocaleString("zh-CN")}</span>
    <span class="unit">条</span>
  </div>
</li>

<style>
  .card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.9rem;
    align-items: center;
    padding: 0.85rem 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    transition: border-color 0.15s;
  }
  .card:hover {
    border-color: var(--border-strong);
  }
  .card[hidden] {
    display: none;
  }
  /* 金银铜：奉牌色进 CSS 变量，边框、名次号、活跃描边统一引用 */
  .card.top-1 {
    --medal: #c9930a;
  }
  .card.top-2 {
    --medal: #7d8da1;
  }
  .card.top-3 {
    --medal: #b0713b;
  }
  .card.top-1,
  .card.top-2,
  .card.top-3 {
    border-color: var(--medal);
  }
  .card.top-1:hover,
  .card.top-2:hover,
  .card.top-3:hover {
    border-color: var(--medal);
  }
  .card.top-1 .rank,
  .card.top-2 .rank,
  .card.top-3 .rank {
    color: var(--medal);
    font-weight: 700;
  }
  /* 前三名的活跃描边也换成奉牌色，避免蓝金打架 */
  .card.active.top-1 .avatar,
  .card.active.top-2 .avatar,
  .card.active.top-3 .avatar {
    box-shadow: 0 0 0 2px var(--surface), 0 0 0 4px var(--medal);
  }
  @media (prefers-color-scheme: dark) {
    .card.top-1 {
      --medal: #e5b83c;
    }
    .card.top-2 {
      --medal: #a8b4c4;
    }
    .card.top-3 {
      --medal: #cf8b50;
    }
  }
  /* 活跃成员：头像描边 + 发言数用强调色 */
  .card.active .avatar {
    box-shadow: 0 0 0 2px var(--surface), 0 0 0 4px var(--accent);
  }
  .card.active .num {
    color: var(--accent);
  }

  .avatar-box {
    position: relative;
    flex: none;
  }
  .crown {
    position: absolute;
    top: -0.85rem;
    left: -0.45rem;
    font-size: 1.2rem;
    transform: rotate(-28deg);
    pointer-events: none;
    user-select: none;
  }

  .avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    overflow: hidden;
    flex: none;
    display: grid;
    place-items: center;
    background: hsl(var(--hue) 55% 88%);
    color: hsl(var(--hue) 50% 32%);
    font-weight: 600;
    font-size: 1.35rem;
  }
  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    .avatar {
      background: hsl(var(--hue) 35% 26%);
      color: hsl(var(--hue) 60% 82%);
    }
  }

  .body {
    min-width: 0;
  }
  .title-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    min-width: 0;
  }
  .rank {
    flex: none;
    font-size: 0.75rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .name {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    /* 最多两行，超出截断；手机上长名字不至于只剩三个字 */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    overflow-wrap: anywhere;
  }
  .sub,
  .alias,
  .remark {
    margin: 0.15rem 0 0;
    font-size: 0.8rem;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .remark {
    color: var(--accent);
  }

  .count {
    text-align: right;
    flex: none;
    font-variant-numeric: tabular-nums;
  }
  .num {
    font-size: 1.15rem;
    font-weight: 700;
  }
  .count.zero .num {
    color: var(--muted);
    font-weight: 500;
  }
  .unit {
    font-size: 0.75rem;
    color: var(--muted);
    margin-left: 0.15rem;
  }
</style>
