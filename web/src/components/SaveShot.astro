---
// 右下角悬浮按钮：把当前页面（含搜索/筛选后的状态）保存为 PNG 截图。
// 用 snapdom（html2canvas 的现代替代）做 DOM → 图片；库 ~160 KB，
// 首次点击才动态 import（Vite 自动分包），不进首屏关键路径，保持零 JS 优势。
---

<button
  id="save-shot"
  class="shot-fab"
  type="button"
  aria-label="保存页面截图"
  title="保存页面为截图（PNG）"
>
  <svg class="cam" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M4 7h2.6l1.5-2.2A1.5 1.5 0 0 1 9.35 4h5.3a1.5 1.5 0 0 1 1.25.8L17.4 7H20a1.5 1.5 0 0 1 1.5 1.5V18A1.5 1.5 0 0 1 20 19.5H4A1.5 1.5 0 0 1 2.5 18V8.5A1.5 1.5 0 0 1 4 7Z" />
    <circle cx="12" cy="13" r="3.5" />
  </svg>
</button>

<script>
  const btn = document.getElementById("save-shot") as HTMLButtonElement;

  async function capture() {
    btn.disabled = true;
    btn.classList.add("busy");
    try {
      const { snapdom } = await import("@zumer/snapdom");
      const el = document.body;
      // 画布预算：像素总量与单边长度超限时先降 dpr 再整体缩放，
      // 防止长页面（400+ 卡片）在移动端撞 canvas 尺寸上限导致空白图
      const AREA = 64e6;
      const SIDE = 30000;
      const w = el.scrollWidth;
      const h = el.scrollHeight;
      let dpr = Math.min(window.devicePixelRatio || 1, 2);
      if (w * h * dpr * dpr > AREA || Math.max(w, h) * dpr > SIDE) dpr = 1;
      const scale = Math.min(
        1,
        Math.sqrt(AREA / (w * h * dpr * dpr)),
        SIDE / (Math.max(w, h) * dpr),
      );
      const date = new Date().toISOString().slice(0, 10);
      await snapdom.download(el, {
        format: "png",
        dpr,
        scale,
        // 悬浮按钮不入镜；hide 模式保持布局（fixed 元素本就不占布局）
        exclude: [".shot-fab"],
        // PNG 默认透明底，补上当前主题的页面底色
        backgroundColor: getComputedStyle(el).backgroundColor,
        filename: `${document.title} ${date}`,
      });
    } catch (err) {
      console.error("截图失败", err);
      btn.classList.add("error");
      setTimeout(() => btn.classList.remove("error"), 1500);
    } finally {
      btn.disabled = false;
      btn.classList.remove("busy");
    }
  }

  btn.addEventListener("click", capture);
</script>

<style>
  .shot-fab {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1.25rem, env(safe-area-inset-bottom));
    z-index: 20;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    background: var(--surface);
    color: var(--muted);
    display: grid;
    place-items: center;
    cursor: pointer;
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.18);
    transition:
      color 0.15s,
      border-color 0.15s;
  }
  .shot-fab:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .shot-fab:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .shot-fab:disabled {
    cursor: progress;
  }
  .shot-fab.busy .cam {
    display: none;
  }
  .shot-fab.busy::after {
    content: "";
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 2px solid var(--border-strong);
    border-top-color: var(--accent);
    animation: shot-spin 0.7s linear infinite;
  }
  @keyframes shot-spin {
    to {
      transform: rotate(1turn);
    }
  }
  .shot-fab.error {
    color: #dc2626;
    border-color: #dc2626;
  }

  @media print {
    .shot-fab {
      display: none;
    }
  }
</style>
